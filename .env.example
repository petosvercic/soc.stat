# Copy to .env.lokal or .env.local. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Application API token (required in production)
APP_API_TOKEN=replace-with-app-token

# Paywall integration (required in production)
PAYWALL_TOKEN=replace-with-paywall-management-token
PAYWALL_PROVIDER_URL=https://paywall.example.com
PAYWALL_PUBLIC_KEY=pk_live_replace_me

# Deployment and repo integration tokens (optional for runtime health checks)
VERCEL_TOKEN=replace-with-vercel-token
REPO_SYNC_TOKEN=replace-with-repo-sync-token
